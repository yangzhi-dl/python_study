# ============================================
# Python 学习项目 .gitignore
# ============================================

# ---------- 虚拟环境（体积大，可重建）----------
.venv/
venv/
env/
ENV/
.conda/

# ---------- 密钥与环境变量（绝不能提交）----------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# ---------- Python 编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---------- 打包与构建 ----------
build/
dist/
*.egg-info/
.eggs/
wheels/

# ---------- IDE 配置 ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- 测试与覆盖率 ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---------- 类型检查与格式化缓存 ----------
.mypy_cache/
.dmypy.json
.ruff_cache/
.pyright/

# ---------- 日志 ----------
*.log
logs/

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 数据与模型文件（体积大）----------
*.sqlite
*.db
*.pkl
*.h5
*.pt
*.pth
*.onnx
data/
models/
